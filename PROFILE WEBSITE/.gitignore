# ============================================
# Package Manager Files (lock files stay - needed for reproducible builds)
# ============================================
# Keep package-lock.json, yarn.lock, pnpm-lock.yaml
# but ignore node_modules (already covered above)

# ============================================
# React / Vite Specific
# ============================================
*.local
storybook-static/

# ============================================
# Misc Generated Files
# ============================================
*.pid
*.seed
*.pid.lock
.DS_Store

# ============================================
# Files to KEEP TRACKED (explicitly whitelist)
# ============================================
# src/          - Source code
# public/       - Static assets (favicon, etc.)
# package.json  - Dependencies
# package-lock.json - Lock file
# vite.config.js - Build config
# firebase.json - Firebase config
# firestore.rules - Firestore security rules
# README.md    - Documentation
# .gitignore   - This file

# ============================================
# Remove tracked cached files (run if already committed)
# ============================================
# To remove sensitive files from git tracking after adding to .gitignore:
#   git rm -r --cached node_modules
#   git rm --cached .env
#   git rm -r --cached dist
#   git rm -r --cached .firebase
# Then commit: git commit -m "Remove sensitive files from tracking"