rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read access for all collections
    match /projects/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    match /blogs/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    match /services/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    match /gallery/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    match /testimonials/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    match /skills/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    match /messages/{document} {
      allow read: if request.auth != null && request.auth.uid != null;
      allow create: if true;
      allow delete: if request.auth != null && request.auth.uid != null;
    }
    match /inquiries/{document} {
      allow read: if request.auth != null && request.auth.uid != null;
      allow create: if true;
      allow write: if request.auth != null && request.auth.uid != null;
      allow delete: if request.auth != null && request.auth.uid != null;
    }
    match /resume/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    match /socialLinks/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    match /users/{document} {
      allow read: if request.auth != null && request.auth.uid == document;
      allow write: if request.auth != null && request.auth.uid == document;
    }
  }
}